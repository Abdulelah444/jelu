# Copy to .env and adjust. docker compose reads .env automatically.

# Where all data (Jelu database, covers, imports, ebooks, Shelfmark config) lives.
# This is the one setting you must get right: if it points at an empty folder the
# app starts with a new, empty database and NO user account.
#   - Fresh install:  leave the default (./data next to this file)
#   - Existing data:  set it to the folder that already holds config/, database/
#                     and images/, e.g. /opt/jelu-data
#JELU_DATA_DIR=./data

# Optional shared secret that protects the Shelfmark settings API.
# When set, Jelu uses it to push settings to Shelfmark and
# scripts/bootstrap-shelfmark.sh uses it too. When blank, both run without
# authentication (fine on a trusted LAN).
# Generate with: openssl rand -base64 32
#SHELFMARK_API_KEY=

# Pin the Shelfmark image instead of tracking :latest
#SHELFMARK_TAG=latest

# Image tag built for Jelu (default: jelu:local)
#JELU_IMAGE=jelu:local

# Folder layout expected under JELU_DATA_DIR:
#   config/  database/  files/images/  files/imports/  ebooks/  cwa-config/
