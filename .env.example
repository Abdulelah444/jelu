# Copy to .env and adjust. docker compose reads .env automatically.

# Where all data (Jelu database, covers, imports, ebooks, Shelfmark config) lives.
# Defaults to ./data next to the compose file.
#JELU_DATA_DIR=/opt/jelu-data

# Optional shared secret that protects the Shelfmark settings API.
# When set, Jelu uses it to push settings to Shelfmark; when blank, both run
# without authentication (fine on a trusted LAN).
# Generate with: openssl rand -base64 32
#SHELFMARK_API_KEY=
